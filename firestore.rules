rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read/write their own user document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow authenticated users to read all users (for team selection, etc.)
    match /users/{document=**} {
      allow read: if request.auth != null;
    }
    
    // Teams: Read for authenticated, write for admins/team-reps
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'TEAM_REP']);
    }
    
    // Players: Read for authenticated, write for admins/players
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'PLAYER'] ||
         request.auth.uid == playerId);
    }
    
    // Matches/Auctions: Read for authenticated, write for admins/auctioneers
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'AUCTIONEER']);
    }
    
    // Bids: Read for authenticated, write for authenticated (anyone can bid)
    match /bids/{bidId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // History: Read for authenticated, write for admins/auctioneers
    match /history/{historyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'AUCTIONEER']);
    }
    
    // Live Auction Events: Read for all authenticated, write for system only
    match /liveAuctions/{seasonId}/events/{eventType} {
      allow read: if request.auth != null;
      allow write: if false; // Only backend can write
    }
    
    // Squads: Read for authenticated, write for admins/team-reps
    match /squads/{squadId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'TEAM_REP']);
    }
    
    // Backups: Read for admins/auctioneers, write for admins only (managed by Cloud Functions)
    match /backups/{backupId} {
      allow read: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'AUCTIONEER']);
      allow write: if false; // Only backend Cloud Functions can write
    }
    
    // Auto Backup Configs: Read for admins/auctioneers, write for admins only
    match /autoBackupConfigs/{configId} {
      allow read: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'AUCTIONEER']);
      allow write: if false; // Only backend Cloud Functions can write
    }
    
    // Default: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
